# Copia este archivo a .env.local y completa los valores (nunca subas .env.local).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=root
MYSQL_PASSWORD=
# 1 en TiDB Cloud y otros MySQL gestionados (exigen TLS); vacío en local.
MYSQL_SSL=

# Login del admin (ADR 0005). Genera el hash con: npm run hash-clave -- 'la-clave'
# En .env.local escapa los $ del hash como \$ (Next los expande); en Netlify va tal cual.
SESSION_SECRET=
DEMO_USER=
DEMO_PASSWORD_HASH=
